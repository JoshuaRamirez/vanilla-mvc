{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "paths": {
      "/dist/*": [
        "./dist/*"
      ]
    }
  },
  "include": [
    "test/*.mjs",
    "test/browser/*.js",
    "server.mjs",
    "testing/**/*.mjs",
    "bin/*.mjs",
    "architecture/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
